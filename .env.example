# API providers (set only the providers you plan to use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Voice providers
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_TTS_VOICE=Kore
# Optional batch/quality tuning (defaults shown)
SVF_TTS_CHUNK_MAX_CHARS=900
SVF_TTS_CHUNK_PAUSE_SECONDS=0.35
SVF_TTS_MIN_RMS_DBFS=-50
SVF_TTS_MAX_CLIPPING_RATIO=0.01

# Bounded AI repair attempts after deterministic prototype validation (0-3)
SVF_PROTOTYPE_REPAIR_ATTEMPTS=2

# Optional CLI locations when the binaries are not on PATH
SVF_CODEX_BIN=
SVF_GROK_BIN=
SVF_ANTIGRAVITY_BIN=
SVF_COPILOT_BIN=

# Image-first sketch pipeline
# Factory Desk exposes separate `sketch_asset_planner` and `sketch_imagegen`
# model-routing rows. Image generation uses Codex's system imagegen skill +
# preferred built-in image_gen tool.
# Set this only when you want to override the model selected in sketch_imagegen.
SVF_CODEX_IMAGE_MODEL=
SVF_IMAGEGEN_TIMEOUT_SECONDS=900

# Optional image-to-video animation command.
# Leave blank to generate the keyframe PNG + Grok-ready prompt only; the preview will use the static PNG.
# The command may use these placeholders:
#   {image}    absolute whiteboard PNG path
#   {prompt}   absolute animation-prompt text path
#   {output}   target MP4 path
#   {duration} Director scene duration in seconds
#   {scene_id} Director scene ID
# Example shape only — adapt to the actual Grok/Imagine media CLI you use:
# SVF_GROK_ANIMATE_COMMAND=grok-media animate --image {image} --prompt-file {prompt} --duration {duration} --output {output}
SVF_GROK_ANIMATE_COMMAND=
SVF_GROK_ANIMATE_TIMEOUT_SECONDS=1200
