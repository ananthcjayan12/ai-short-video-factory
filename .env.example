# API providers (set only the providers you plan to use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Voice providers
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_TTS_VOICE=Kore
# Optional batch/quality tuning (defaults shown)
SVF_TTS_CHUNK_MAX_CHARS=900
SVF_TTS_CHUNK_PAUSE_SECONDS=0.35
SVF_TTS_MIN_RMS_DBFS=-50
SVF_TTS_MAX_CLIPPING_RATIO=0.01

# Bounded AI repair attempts after deterministic prototype validation (0-3)
SVF_PROTOTYPE_REPAIR_ATTEMPTS=2

# Optional CLI locations when the binaries are not on PATH
SVF_CODEX_BIN=
SVF_GROK_BIN=
SVF_ANTIGRAVITY_BIN=
SVF_COPILOT_BIN=
